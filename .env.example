# --- Telegram ---
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# (опционально) ограничить работу бота одной группой обсуждений
TARGET_CHAT_ID=

# --- Moderation switches ---
# Удалять сообщения от сторонних каналов (их реального автора Telegram не раскрывает).
# Анонимные администраторы группы и автопосты связанного канала всегда исключены.
DELETE_CHANNEL_MESSAGES=true

# Порог рекламы без ссылок. Любые ссылки и медиа удаляются независимо от порога.
AD_SCORE_THRESHOLD=2

# Удалять начиная с третьего одинакового сообщения за 60 секунд.
SPAM_REPEAT_LIMIT=3
SPAM_REPEAT_WINDOW=60
# Удалять начиная с шестого сообщения за 10 секунд.
SPAM_FLOOD_LIMIT=6
SPAM_FLOOD_WINDOW=10

# --- Logging ---
LOG_LEVEL=INFO
